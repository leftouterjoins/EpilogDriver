#!/bin/bash
#
# postinstall - Post-installation script for Epilog Zing driver
#
# This script runs after the package files are installed.
# It sets up permissions.
#

set -e

FILTER_DIR="/Library/Printers/Epilog/Filters"
PPD_DIR="/Library/Printers/PPDs/Contents/Resources"

echo "Epilog Zing Driver: Running post-installation..."

# Ensure correct ownership
chown root:wheel "$FILTER_DIR/rastertoepiloz"
chown root:wheel "$PPD_DIR/EpilogZing16.ppd"
chown root:wheel "$PPD_DIR/EpilogZing24.ppd"

# Ensure correct permissions
chmod 755 "$FILTER_DIR/rastertoepiloz"
chmod 644 "$PPD_DIR/EpilogZing16.ppd"
chmod 644 "$PPD_DIR/EpilogZing24.ppd"

# Create symlink in CUPS filter directory
if [ -d "/usr/libexec/cups/filter" ]; then
    ln -sf "$FILTER_DIR/rastertoepiloz" "/usr/libexec/cups/filter/rastertoepiloz" 2>/dev/null || true
fi

# Repoint any existing Epilog queues at the freshly installed PPD.
#
# CUPS copies the PPD into /etc/cups/ppd/<queue>.ppd when a printer is added and
# never looks at the original again, so upgrading the driver leaves existing
# printers running the PPD they were created with. That silently withholds new
# options and settings from anyone who already had the printer set up, and the
# only remedies are running lpadmin by hand or deleting and re-adding the
# printer. Neither is acceptable to ask of someone who just ran an installer, so
# do it here where we already have root.
#
# Deliberately non-fatal: a queue that cannot be updated must not fail the whole
# installation, since the driver and PPDs are already in place by this point.
LPADMIN=/usr/sbin/lpadmin
[ -x "$LPADMIN" ] || LPADMIN=$(command -v lpadmin 2>/dev/null || true)

# Enumerate real queues from printers.conf rather than by globbing
# /etc/cups/ppd. Two reasons:
#
#   - Orphaned PPDs are left behind when a printer is removed, and `lpadmin -p`
#     on a name with no queue CREATES one: a phantom printer with no device URI.
#   - lpstat has to reach cupsd, which is not dependable inside the installer's
#     environment. printers.conf is a plain file and is always readable as root,
#     so queue discovery works whether or not the scheduler is up.
list_queues() {
    [ -r /etc/cups/printers.conf ] || return 0
    sed -n 's/^<[[:space:]]*\(Default\)\{0,1\}Printer[[:space:]]\{1,\}\([^>]*\)>.*/\2/p' \
        /etc/cups/printers.conf
}

if [ -d /etc/cups/ppd ]; then
    echo "Epilog Zing Driver: Updating existing printer queues..."
    updated=0

    for queue in $(list_queues); do
        qppd="/etc/cups/ppd/$queue.ppd"
        [ -f "$qppd" ] || continue
        grep -qi "epilog" "$qppd" 2>/dev/null || continue

        # Match the queue to its model so a Zing 16 is not handed a 24" bed.
        if grep -qi "Zing 16" "$qppd" 2>/dev/null; then
            newppd="$PPD_DIR/EpilogZing16.ppd"
        else
            newppd="$PPD_DIR/EpilogZing24.ppd"
        fi

        [ -f "$newppd" ] || continue

        # Prefer lpadmin so cupsd learns about the change immediately. If the
        # scheduler is not reachable, install the PPD directly - that is what
        # lpadmin does to it anyway, and cupsd picks it up when it next starts.
        if [ -n "$LPADMIN" ] && [ -x "$LPADMIN" ] \
           && "$LPADMIN" -p "$queue" -P "$newppd" 2>/dev/null; then
            echo "  updated queue '$queue' -> $(basename "$newppd")"
            updated=$((updated + 1))
        elif cp "$newppd" "$qppd" 2>/dev/null; then
            chown root:_lp "$qppd" 2>/dev/null || true
            chmod 644 "$qppd" 2>/dev/null || true
            echo "  updated queue '$queue' -> $(basename "$newppd") (direct)"
            updated=$((updated + 1))
        else
            echo "  WARNING: could not update queue '$queue'."
            echo "           Run: sudo lpadmin -p '$queue' -P '$newppd'"
        fi
    done

    # Note: written as an if, not `[ ... ] && echo`, because a false test would
    # return non-zero and abort the script under `set -e`.
    if [ "$updated" = "0" ]; then
        echo "  (no existing Epilog queues found)"
    fi
fi

echo "Epilog Zing Driver: Installation complete."
echo ""
echo "To add the printer:"
echo "  1. Open System Preferences > Printers & Scanners"
echo "  2. Click + > Select IP tab"
echo "  3. Address: Enter your laser's IP (default: 192.168.3.4)"
echo "  4. Protocol: Line Printer Daemon - LPD"
echo "  5. Queue: Leave empty"
echo "  6. Use: Select 'Epilog Zing 16' or 'Epilog Zing 24'"
echo ""
echo "Or via command line:"
echo "  lpadmin -p 'Epilog-Zing' -E -v lpd://192.168.3.4 -P '$PPD_DIR/EpilogZing16.ppd'"

exit 0
